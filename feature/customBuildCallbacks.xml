<?xml version="1.0" encoding="UTF-8"?>
<project name="comfort.site.callbacks">
	<dirname property="comfort.feature.dir" file="${ant.file.comfort.site.callbacks}"/>
	<property name="comfort.site.dir" location="${comfort.feature.dir}/../site"/>
	<property name="comfort.state.dir" location="${comfort.feature.dir}/../.tmp/checks-site"/>

	<!-- sync удаляет JAR при каждой сборке. p2 хранит дескрипторы в памяти EDT:
	     сброс нужен каждый раз, в том числе без предварительного clean.bat. -->
	<target name="reset-p2">
		<mkdir dir="${comfort.state.dir}"/>
		<local name="comfort.reset.time"/>
		<tstamp><format property="comfort.reset.time" pattern="yyyy-MM-dd HH:mm:ss.SSS"/></tstamp>
		<makeurl file="${comfort.site.dir}" property="comfort.site.url"/>
		<echo file="${comfort.state.dir}/build-diagnostic.log" append="true" encoding="UTF-8" message="${comfort.reset.time} reset-p2 begin: ${comfort.site.url}${line.separator}"/>
		<eclipse.publish.featuresAndBundles repository="${comfort.site.url}" append="false" compress="true"/>
		<echo file="${comfort.state.dir}/build-diagnostic.log" append="true" encoding="UTF-8" message="${comfort.reset.time} reset-p2 completed${line.separator}"/>
	</target>

	<target name="pre.gather.bin.parts" depends="reset-p2"/>
	<target name="post.gather.bin.parts"/>
</project>
